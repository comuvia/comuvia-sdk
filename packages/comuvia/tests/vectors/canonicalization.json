{
  "description": "RFC 8785 canonicalization and strict-parsing vectors: OSS-0 review section 6.6 I1-I6, with I6 integers amended by OSS-1A review R1, and the R2 nesting limit. I1 expected outputs are copied from the RFC 8785 text, not generated by the comuvia encoder.",
  "rfc8785_text_sha256": "63d52294eb0e3f0014174288186d388b4ddbf2c67d1ce8af1d9726eb0c3ab240",
  "conventions": {
    "input_text": "JSON text given to the strict parser, then canonicalized",
    "input_hex": "raw input bytes in hexadecimal",
    "ieee754_hex": "a binary64 value, big-endian hexadecimal, serialized as a JSON number",
    "canonical_text": "expected canonical output as a string (its UTF-8 bytes are the canonical bytes)",
    "canonical_hex": "expected canonical UTF-8 bytes in hexadecimal",
    "value_order": "expected order of the object's member values after canonicalization",
    "nested_arrays": "input is N opening brackets followed by N closing brackets",
    "stage": "'canonicalize' builds the nested value directly and canonicalizes it; default is parse then canonicalize",
    "idempotence": "every accepted case also satisfies canonicalize(parse(canonical)) == canonical",
    "refusal": "expected refusal code"
  },
  "cases": [
    {
      "id": "I1-rfc8785-3.2.2-primitives",
      "group": "I1",
      "source": "RFC 8785 sections 3.2.2 (input) and 3.2.4 (expected UTF-8 bytes)",
      "input_text": "{\n  \"numbers\": [333333333.33333329, 1E30, 4.50,\n              2e-3, 0.000000000000000000000000001],\n  \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n  \"literals\": [null, true, false]\n}",
      "expect": {
        "canonical_hex": "7b226c69746572616c73223a5b6e756c6c2c747275652c66616c73655d2c226e756d62657273223a5b3333333333333333332e333333333333332c31652b33302c342e352c302e3030322c31652d32375d2c22737472696e67223a22e282ac245c75303030665c6e4127425c225c5c5c5c5c222f227d"
      }
    },
    {
      "id": "I1-rfc8785-3.2.3-sorting",
      "group": "I1",
      "source": "RFC 8785 section 3.2.3 (input and expected argument order)",
      "input_text": "{\n  \"\\u20ac\": \"Euro Sign\",\n  \"\\r\": \"Carriage Return\",\n  \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n  \"1\": \"One\",\n  \"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n  \"\\u0080\": \"Control\",\n  \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n}",
      "expect": {
        "value_order": [
          "Carriage Return",
          "One",
          "Control",
          "Latin Small Letter O With Diaeresis",
          "Euro Sign",
          "Emoji: Grinning Face",
          "Hebrew Letter Dalet With Dagesh"
        ]
      }
    },
